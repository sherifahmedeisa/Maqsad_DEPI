{
  "name": "maqsad-backend",
  "version": "1.0.0",
  "description": "Express backend for Maqsad B2B with local auth and ERD-based schema",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "install:frontend": "npm install --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run install:frontend && npm run build:frontend",
    "dev:backend": "nodemon src/app.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "jsonwebtoken": "^9.0.2",
    "nodemon": "^3.1.14",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.32.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
